#include <iostream>
#include <string>
using namespace std;

// Bubble Sort function
string bubbleSort(string s) {
    int n = s.length();
    for (int i = 0; i < n - 1; i++)
        for (int j = 0; j < n - i - 1; j++)
            if (s[j] > s[j + 1])
                swap(s[j], s[j + 1]);
    return s;
}

// Selection Sort function
string selectionSort(string s) {
    int n = s.length();
    for (int i = 0; i < n - 1; i++) {
        int min_idx = i;
        for (int j = i + 1; j < n; j++)
            if (s[j] < s[min_idx])
                min_idx = j;
        swap(s[i], s[min_idx]);
    }
    return s;
}

int main() {
    string input;

    cout << "Enter a string: ";
    cin >> input;

    string sortedByBubble = bubbleSort(input);
    string sortedBySelection = selectionSort(input);

    cout << "\nOriginal String: " << input << endl;
    cout << "Sorted using Bubble Sort: " << sortedByBubble << endl;
    cout << "Sorted using Selection Sort: " << sortedBySelection << endl;

    return 0;
}
