#include<iostream>
using namespace std;

int main()
{
    // Given characters
    char arr[] = {'L', 'A', 'C', 'N', 'O', 'F', 'W'};
    int n = sizeof(arr)/sizeof(arr[0]);

    // Bubble Sort
    for(int i = 0; i < n - 1; ++i)
    {
        for(int j = 0; j < n - i - 1; ++j)
        {
            if(arr[j] > arr[j + 1])
            {
                // Swap
                char temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    // Output the sorted characters
    cout << "Sorted characters: ";
    for(int i = 0; i < n; ++i)
    {
        cout << arr[i] << " ";
    }

    cout << endl;
    return 0;
}
