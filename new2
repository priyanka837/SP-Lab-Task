#include<iostream>
using namespace std;
int main()
{
    int n;
    cout <<"total charecters: ";
    cin>>n;
    char arr[100];
    cout << "enter"<<n<< "charecters:\n";

    for(int i=0;i<n;++i)
    {cin >> arr[i];}

        for(int i=0;i<n-1;i++){
                int minindex=i;
        for (int j=i+1;j<n;j++){
            if (arr[j]<arr[minindex]){
                minindex = j;
            }
        }

            if(minindex !=i){
                char temp = arr[i];
                arr[i]=arr[minindex];
                arr[minindex]=temp;
            }

        }

    cout<<"sorted characters:";
    for(int i=0;i<n;++i)
    {
    cout << arr[i]<<" ";
    }
    cout<< endl;
    return 0;
 }
